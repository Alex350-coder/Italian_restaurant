# ===========================================
# Italian Restaurant MVP - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# ---------- General ----------
NODE_ENV=development
PORT=3001

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=italian_restaurant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/italian_restaurant

# ---------- Redis ----------
REDIS_PASSWORD=redis
REDIS_URL=redis://:redis@localhost:6379

# ---------- Authentication ----------
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ---------- Client ----------
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api

# ---------- SMTP (Email) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@italianrestaurant.com

# ---------- File Uploads ----------
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
